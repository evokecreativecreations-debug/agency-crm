# Copy this file to ".env.local" and fill in your real values.
# ".env.local" is already ignored by git — it will NEVER be uploaded or shared.

# --- Supabase (Phase 0 requirement) ---
# Find these in your Supabase project: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# --- Supabase Service Role Key (Phase 3 requirement) ---
# Find this in your Supabase project: Project Settings > API > service_role
# secret. This key bypasses Row Level Security completely — it is used
# ONLY on the server (app/api/inquiries/route.ts) to let your public
# website's contact form save inquiries without a logged-in session.
# NEVER put this in a NEXT_PUBLIC_ variable and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Website Integration (Phase 3 requirement) ---
# A secret key YOU create (any long random string), used to verify that
# inquiries hitting /api/inquiries actually came from your website's
# contact form and not a random visitor. Your website's contact form
# must send this same value in an "x-inquiry-secret" header.
INQUIRY_API_SECRET=change-this-to-a-long-random-string

# The origin of your live marketing website (used for CORS on
# /api/inquiries), e.g. https://youragency.com. Defaults to allowing any
# origin ("*") if left blank — fine for local testing, but set this to
# your real website's URL before going live.
WEBSITE_ORIGIN=

# --- Email Sending (used later, Phase 14 — Messages module) ---
# Not needed yet. Left here so the structure is ready when we get there.
# RESEND_API_KEY==